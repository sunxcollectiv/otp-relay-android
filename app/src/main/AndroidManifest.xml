<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The broadcast for an arriving message, which is how the relay sees a code.
      READ_SMS is deliberately not declared: it only grants the existing inbox,
      which the relay does not need. Note that this is a Play Console sensitive
      permission and requires a declaration form before release.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!--
      RECEIVE_SMS would otherwise imply telephony is required, hiding the app
      from devices without it on Play. It installs fine there; the SMS
      requirement row simply never gets anything to relay.
    -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Lets the app show the one-tap "always run in background" dialog instead of
      sending the user to hunt through the battery optimization list. A normal
      permission, but Play restricts it to apps whose core function needs it.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.OTPRelay">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OTPRelay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Starts disabled; the power button enables it through RelaySwitch, so an
          app with the relay off is never woken for incoming texts. Exported so
          the system can deliver to it, and guarded by BROADCAST_SMS so nothing
          but the telephony stack can.
        -->
        <receiver
            android:name=".relay.SmsRelayReceiver"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
