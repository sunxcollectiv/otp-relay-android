<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower.
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Session and device tokens are tied to this install; a restored copy
         would be a revoked or duplicate device, so sign-in never carries over. -->
    <exclude domain="file" path="datastore/auth.preferences_pb" />
</full-backup-content>
